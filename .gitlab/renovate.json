{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "assignees": ["pawelbbdrozd"],
  "packageRules": [
    {
      "groupName": "jest",
      "matchPackageNames": ["/jest/", "/ts-jest/", "/@types/jest/"]
    },
    {
      "groupName": "eslint",
      "matchPackageNames": ["/^eslint/", "!eslint-config-next"]
    }
  ]
}
